# Base URL of the FastAPI backend (no trailing slash).
# Leave EMPTY to use the Vite dev proxy — required for Codespaces / cloud IDEs.
# Set to http://localhost:8000 only if running frontend and backend on the same local machine.
VITE_API_URL=

# Must match API_TOKEN in the backend .env
VITE_API_TOKEN=your_secret_token_here
