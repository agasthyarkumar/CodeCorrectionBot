# ─── LLM Provider ────────────────────────────────────────────────────────────
# Which LLM backend to use. Supported values: grok | openai | anthropic
LLM_PROVIDER=grok

# Model identifier for the chosen provider.
#   grok      → grok-beta
#   openai    → gpt-4o
#   anthropic → claude-opus-4-7
LLM_MODEL=grok-beta

# API key for the chosen provider.
LLM_API_KEY=your_api_key_here

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret token the frontend must include as: Authorization: Bearer <token>
API_TOKEN=your_secret_token_here

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Format: <count>/<period>   period: second | minute | hour | day
RATE_LIMIT=5/minute
