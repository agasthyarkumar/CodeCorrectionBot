# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported values: groq | grok | openai | anthropic
LLM_PROVIDER=groq

# Model identifier for the chosen provider.
#   groq      → openai/gpt-oss-120b  (Groq Cloud — console.groq.com)
#   grok      → grok-4.20-reasoning  (xAI — console.x.ai)
#   openai    → gpt-4o               (OpenAI — platform.openai.com)
#   anthropic → claude-opus-4-7      (Anthropic — console.anthropic.com)
LLM_MODEL=openai/gpt-oss-120b

# Reasoning effort for reasoning-capable models: low | medium | high
# Leave empty to omit (non-reasoning models ignore or reject this field).
LLM_REASONING_EFFORT=medium

# API key for the chosen provider.
LLM_API_KEY=your_api_key_here

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret token the frontend must include as: Authorization: Bearer <token>
API_TOKEN=your_secret_token_here

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Format: <count>/<period>   period: second | minute | hour | day
RATE_LIMIT=5/minute

# ─── Agent Settings ───────────────────────────────────────────────────────────
# Maximum number of generate→execute→fix iterations before giving up
AGENT_MAX_ITERATIONS=5
# Seconds to allow each Python execution before killing it
AGENT_EXEC_TIMEOUT=10
